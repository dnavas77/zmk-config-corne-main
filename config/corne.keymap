#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        win_main {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&kp TAB         &kp Q  &kp W  &kp E         &kp R  &kp T               &kp Y      &kp U        &kp I         &kp O    &kp P          &kp ESC
&kp BACKSPACE   &kp A  &kp S  &kp D         &kp F  &kp G               &kp H      &kp J        &kp K         &kp L    &kp SEMICOLON  &kp APOSTROPHE
&kp LEFT_SHIFT  &kp Z  &kp X  &kp C         &kp V  &kp B               &kp N      &kp M        &kp COMMA     &kp DOT  &kp SLASH      &kp RIGHT_SHIFT
                              &kp LEFT_ALT  &mo 3  &kp LEFT_CONTROL    &kp ENTER  &lt 4 SPACE  &kp LEFT_GUI
            >;

            label = "windows";
        };

        colemak-dh {
            bindings = <
&trans  &kp Q  &kp W  &kp F   &kp P   &kp B     &kp J   &kp L   &kp U      &kp Y    &kp SEMICOLON  &trans
&trans  &kp A  &kp R  &kp S   &kp T   &kp G     &kp M   &kp N   &kp E      &kp I    &kp O          &trans
&trans  &kp Z  &kp X  &kp C   &kp D   &kp V     &kp K   &kp H   &kp COMMA  &kp DOT  &kp SLASH      &trans
                      &trans  &trans  &trans    &trans  &trans  &trans
            >;

            label = "colemak";
        };

        mac_main {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans       &trans            &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans       &trans            &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans       &trans            &trans  &trans  &trans
                        &trans  &trans  &kp LEFT_GUI    &trans  &lt 5 SPACE  &kp LEFT_CONTROL
            >;

            label = "macbook";
        };

        numbers_symbols {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BSPC |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp TILDE    &kp EXCL          &kp AT          &kp POUND        &kp DOLLAR         &kp PERCENT         &kp CARET  &kp AMPERSAND   &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp PLUS
&kp MINUS    &kp NUMBER_1      &kp NUMBER_2    &kp NUMBER_3     &kp NUMBER_4       &kp N5              &kp N6     &kp N7          &kp N8        &kp N9                &kp N0                 &kp EQUAL
&lt 6 GRAVE  &kp LEFT_BRACKET  &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp RIGHT_BRACKET  &kp GREATER_THAN    &kp COLON  &kp PIPE        &kp COMMA     &kp PERIOD            &kp SLASH              &kp BACKSLASH
                                               &trans           &trans             &trans              &trans     &kp UNDERSCORE  &trans
            >;

            label = "symbols";
        };

        win_nav {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BSPC |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&trans  &trans  &kp F7  &kp F8              &kp F9  &kp F10    &kp HOME        &kp PAGE_DOWN           &kp PAGE_UP        &kp END          &kp PRINTSCREEN  &trans
&trans  &trans  &kp F4  &kp F5              &kp F6  &kp F11    &kp LEFT_ARROW  &kp DOWN_ARROW          &kp UP_ARROW       &kp RIGHT_ARROW  &kp DELETE       &trans
&trans  &trans  &kp F1  &kp F2              &kp F3  &kp F12    &trans          &kp LC(LG(LEFT_ARROW))  &kp LC(LG(RIGHT))  &trans           &trans           &trans
                        &kp LA(LC(DELETE))  &trans  &trans     &trans          &trans                  &trans
            >;

            label = "win_nav";
        };

        mac_nav {
            bindings = <
&trans  &trans  &kp F7  &kp F8  &kp F9  &kp F10         &kp LG(LEFT_ARROW)  &kp PAGE_DOWN   &kp PAGE_UP   &kp LG(RIGHT_ARROW)  &kp LS(LG(NUMBER_4))  &trans
&trans  &trans  &kp F4  &kp F5  &kp F6  &kp F11         &kp LEFT_ARROW      &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW      &kp DELETE            &trans
&trans  &trans  &kp F1  &kp F2  &kp F3  &kp F12         &trans              &trans          &trans        &trans               &trans                &trans
                        &trans  &trans  &kp LEFT_ALT    &trans              &trans          &trans
            >;

            label = "mac_nav";
        };

        calc_and_bluetooth {
            bindings = <
&bt BT_CLR  &none         &kp C_MUTE    &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp C_PLAY_PAUSE    &tog 1     &kp N7        &kp N8        &kp N9        &kp ASTERISK  &kp SLASH
&none       &none         &none         &none              &none            &bt BT_CLR_ALL      &none      &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp PLUS      &kp MINUS
&none       &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2       &bt BT_SEL 3     &bt BT_SEL 4        &tog 2     &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp DOT       &kp COLON
                                        &out OUT_TOG       &none            &none               &kp EQUAL  &kp N0        &none
            >;

            label = "calc_bt";
        };
    };
};
