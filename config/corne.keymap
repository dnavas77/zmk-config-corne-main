#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

&lt { tapping-term-ms = <165>; };

&mt {
    tapping-term-ms = <165>;
    flavor = "tap-preferred";
};

/ {
    combos {
        compatible = "zmk,combos";

        fkey_bt_layer {
            bindings = <&mo 5>;
            key-positions = <3 37>;
        };
    };

    macros {
        bt_mac: bt_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0 &to 1>;
            label = "BT_MAC";
        };

        bt_win: bt_win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1 &to 0>;
            label = "BT_WIN";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        windows {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&kp TAB         &kp Q  &kp W  &kp E         &kp R  &kp T               &kp Y      &kp U        &kp I         &kp O    &kp P          &kp ESC
&kp BACKSPACE   &kp A  &kp S  &kp D         &kp F  &kp G               &kp H      &kp J        &kp K         &kp L    &kp SEMICOLON  &kp APOSTROPHE
&kp LEFT_SHIFT  &kp Z  &kp X  &kp C         &kp V  &kp B               &kp N      &kp M        &kp COMMA     &kp DOT  &kp SLASH      &kp RIGHT_SHIFT
                              &kp LEFT_ALT  &mo 2  &kp LEFT_CONTROL    &kp ENTER  &lt 3 SPACE  &kp LEFT_GUI
            >;

            label = "windows";
        };

        macintosh {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans       &trans            &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans       &trans            &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans       &trans            &trans  &trans  &trans
                        &trans  &trans  &kp LEFT_GUI    &trans  &lt 4 SPACE  &kp LEFT_CONTROL
            >;

            label = "macintosh";
        };

        numbers {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BSPC |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp GRAVE  &kp EXCL          &kp AT          &kp POUND        &kp DOLLAR         &kp PERCENT      &kp CARET         &kp AMPERSAND  &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp PLUS
&kp MINUS  &kp NUMBER_1      &kp NUMBER_2    &kp NUMBER_3     &kp NUMBER_4       &kp N5           &kp N6            &kp N7         &kp N8        &kp N9                &kp N0                 &kp EQUAL
&kp TILDE  &kp LEFT_BRACKET  &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp RIGHT_BRACKET  &kp LESS_THAN    &kp GREATER_THAN  &kp PIPE       &kp COMMA     &kp PERIOD            &kp SLASH              &kp BACKSLASH
                                             &trans           &trans             &trans           &kp UNDERSCORE    &trans         &trans
            >;

            label = "numbers";
        };

        win_nav {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BSPC |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&none   &none  &none  &none  &none  &none     &kp HOME        &none           &kp LA(F4)    &kp END          &kp PRINTSCREEN  &none
&none   &none  &none  &none  &none  &none     &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &kp DELETE       &none
&trans  &none  &none  &none  &none  &none     &none           &kp PAGE_DOWN   &kp PAGE_UP   &none            &none            &none
                      &mo 5  &none  &trans    &none           &none           &none
            >;

            label = "win_nav";
        };

        mac_nav {
            bindings = <
&none   &none  &none  &none  &none  &none           &kp LG(LEFT_ARROW)  &none           &kp LG(W)     &kp LG(RIGHT_ARROW)  &kp LS(LG(NUMBER_4))  &none
&none   &none  &none  &none  &none  &none           &kp LEFT_ARROW      &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW      &kp DELETE            &none
&trans  &none  &none  &none  &none  &none           &none               &kp PAGE_DOWN   &kp PAGE_UP   &none                &none                 &none
                      &mo 5  &none  &kp LEFT_ALT    &none               &none           &none
            >;

            label = "mac_nav";
        };

        fkeys_bt {
            bindings = <
&bt BT_CLR_ALL  &none    &kp C_MUTE  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp C_PLAY_PAUSE    &none  &kp F7    &kp F8        &kp F9  &kp F10  &none
&none           &none    &none       &none              &none            &bt BT_CLR          &none  &kp F4    &kp F5        &kp F6  &kp F11  &none
&none           &bt_mac  &bt_win     &bt BT_SEL 2       &bt BT_SEL 3     &bt BT_SEL 4        &none  &kp F1    &kp F2        &kp F3  &kp F12  &none
                                     &none              &none            &none               &none  &kp RALT  &out OUT_TOG
            >;

            label = "fkeys_bt";
        };
    };
};
