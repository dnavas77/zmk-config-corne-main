#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

&lt { tapping-term-ms = <165>; };

&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <165>;
};

/ {
    combos {
        compatible = "zmk,combos";

        semicolon_all {
            bindings = <&kp SEMI>;
            key-positions = <32 33>;
            layers = <0 2 1>;
        };

        delete_word_win {
            bindings = <&kp LC(BACKSPACE)>;
            key-positions = <19 40>;
            layers = <0>;
        };

        delete_word_mac {
            bindings = <&kp LA(BACKSPACE)>;
            key-positions = <40 19>;
            layers = <2>;
        };

        esc_all {
            bindings = <&kp ESCAPE>;
            key-positions = <15 14>;
            layers = <0 2 1>;
        };

        caps_all {
            bindings = <&kp CAPSLOCK>;
            key-positions = <16 15>;
            layers = <0 2 1>;
        };

        bt_symb_combo {
            bindings = <&mo 6>;
            key-positions = <37 16>;
            layers = <0 1 2>;
        };

        enter_all {
            bindings = <&kp ENTER>;
            key-positions = <20 21>;
            layers = <0 2 1>;
        };
    };

    macros {
        bt_mac: bt_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0 &to 2>;
            label = "BT_MAC";
        };

        bt_win: bt_win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1 &to 0>;
            label = "BT_WIN";
        };

        tap_f1: tap_f1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp F1>;

            label = "tap_f1";
        };

        tap_f2: tap_f2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp F2>;

            label = "tap_f2";
        };

        tap_f3: tap_f3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp F3>;

            label = "tap_f3";
        };

        tap_f4: tap_f4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp F4>;

            label = "tap_f4";
        };

        tap_f5: tap_f5 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp F5>;

            label = "tap_f5";
        };

        tap_f6: tap_f6 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp F6>;

            label = "tap_f6";
        };

        tap_f7: tap_f7 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp F7>;

            label = "tap_f7";
        };

        tap_f8: tap_f8 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp F8>;

            label = "tap_f8";
        };

        tap_f9: tap_f9 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp F9>;

            label = "tap_f9";
        };

        tap_f10: tap_f10 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp F10>;

            label = "tap_f10";
        };

        tap_f11: tap_f11 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp F11>;

            label = "tap_f11";
        };

        tap_f12: tap_f12 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp F12>;

            label = "tap_f12";
        };
    };

    behaviors {
        hold_tap_f1: hold_tap_f1 {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_TAP_F1";
            bindings = <&tap_f1>, <&kp>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <250>;
        };

        hold_tap_f2: hold_tap_f2 {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_TAP_F2";
            bindings = <&tap_f2>, <&kp>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <250>;
        };

        hold_tap_f3: hold_tap_f3 {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_TAP_F3";
            bindings = <&tap_f3>, <&kp>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <250>;
        };

        hold_tap_f4: hold_tap_f4 {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_TAP_F4";
            bindings = <&tap_f4>, <&kp>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <250>;
        };

        hold_tap_f5: hold_tap_f5 {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_TAP_F5";
            bindings = <&tap_f5>, <&kp>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <250>;
        };

        hold_tap_f6: hold_tap_f6 {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_TAP_F6";
            bindings = <&tap_f6>, <&kp>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <250>;
        };

        hold_tap_f7: hold_tap_f7 {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_TAP_F7";
            bindings = <&tap_f7>, <&kp>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <250>;
        };

        hold_tap_f8: hold_tap_f8 {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_TAP_F8";
            bindings = <&tap_f8>, <&kp>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <250>;
        };

        hold_tap_f9: hold_tap_f9 {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_TAP_F9";
            bindings = <&tap_f9>, <&kp>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <250>;
        };

        hold_tap_f10: hold_tap_f10 {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_TAP_F10";
            bindings = <&tap_f10>, <&kp>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <250>;
        };

        hold_tap_f11: hold_tap_f11 {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_TAP_F11";
            bindings = <&tap_f11>, <&kp>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <250>;
        };

        hold_tap_f12: hold_tap_f12 {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_TAP_F12";
            bindings = <&tap_f12>, <&kp>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <250>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        win_main {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&none  &kp Q  &kp W  &kp E         &kp R  &kp T               &kp Y           &kp U        &kp I         &kp O    &kp P           &none
&none  &kp A  &kp S  &kp D         &kp F  &kp G               &kp H           &kp J        &kp K         &kp L    &kp APOSTROPHE  &none
&none  &kp Z  &kp X  &kp C         &kp V  &kp B               &kp N           &kp M        &kp COMMA     &kp DOT  &kp SLASH       &none
                     &kp LEFT_ALT  &mo 3  &kp LEFT_CONTROL    &sk LEFT_SHIFT  &lt 4 SPACE  &kp LEFT_GUI
            >;

            label = "windows";
        };

        colemak-dh {
            bindings = <
&none  &kp Q   &kp W  &kp F   &kp P   &kp B     &kp J   &kp L   &kp U      &kp Y    &kp APOSTROPHE  &none
&none  &kp A   &kp R  &kp S   &kp T   &kp G     &kp M   &kp N   &kp E      &kp I    &kp O           &none
&none  &trans  &kp X  &kp C   &kp D   &kp V     &kp K   &kp H   &kp COMMA  &kp DOT  &trans          &none
                      &trans  &trans  &trans    &trans  &trans  &trans
            >;

            label = "colemak";
        };

        mac_main {
            bindings = <
&none  &trans  &trans  &trans        &trans  &trans          &trans  &trans       &trans             &trans  &trans  &none
&none  &trans  &trans  &trans        &trans  &trans          &trans  &trans       &trans             &trans  &trans  &none
&none  &trans  &trans  &trans        &trans  &trans          &trans  &trans       &trans             &trans  &trans  &none
                       &kp LEFT_ALT  &trans  &kp LEFT_GUI    &trans  &lt 5 SPACE  &kp RIGHT_CONTROL
            >;

            label = "macbook";
        };

        numbers_symbols {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BSPC |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&none  &kp TAB               &kp LEFT_PARENTHESIS  &kp DOUBLE_QUOTES  &kp RIGHT_PARENTHESIS         &kp LESS_THAN    &kp GREATER_THAN  &kp N7        &kp N8        &kp N9        &kp PLUS   &none
&none  &kp BACKSPACE         &kp LEFT_BRACKET      &kp MINUS          &kp RIGHT_BRACKET             &kp COLON        &kp PIPE          &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp EQUAL  &none
&none  &mt LEFT_SHIFT GRAVE  &kp LEFT_BRACE        &kp UNDER          &mt LEFT_CONTROL RIGHT_BRACE  &kp TILDE        &kp BACKSLASH     &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp SLASH  &none
                                                   &trans             &trans                        &trans           &kp ENTER         &kp N0        &trans
            >;

            label = "symbols";
        };

        win_nav {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BSPC |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&none  &kp TAB         &kp AMPERSAND    &kp ASTERISK  &none         &none               &kp HOME        &none           &none         &kp END          &kp PRINTSCREEN     &none
&none  &none           &kp DOLLAR       &kp PERCENT   &kp CARET     &none               &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &kp DELETE          &none
&none  &kp LEFT_SHIFT  &kp EXCLAMATION  &kp AT_SIGN   &kp HASH      &none               &none           &kp PAGE_DOWN   &kp PAGE_UP   &none            &kp LA(LC(DELETE))  &none
                                        &mo 6         &kp LEFT_ALT  &kp LEFT_CONTROL    &none           &none           &none
            >;

            label = "win_nav";
        };

        mac_nav {
            bindings = <
&none  &kp TAB         &kp AMPERSAND    &kp ASTERISK  &none         &none           &kp LG(LEFT_ARROW)  &none           &none         &kp LG(RIGHT_ARROW)  &kp LS(LG(NUMBER_4))  &none
&none  &none           &kp DOLLAR       &kp PERCENT   &kp CARET     &none           &kp LEFT_ARROW      &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW      &kp DELETE            &none
&none  &kp LEFT_SHIFT  &kp EXCLAMATION  &kp AT_SIGN   &kp HASH      &none           &none               &kp PAGE_DOWN   &kp PAGE_UP   &none                &none                 &none
                                        &mo 6         &kp LEFT_GUI  &kp LEFT_ALT    &none               &none           &none
            >;

            label = "mac_nav";
        };

        bluetooth {
            bindings = <
&none  &out OUT_TOG  &kp C_MUTE  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp C_PLAY_PAUSE    &tog 2  &kp F7  &kp F8  &kp F9  &kp F10  &none
&none  &none         &none       &none              &bt BT_CLR       &bt BT_CLR_ALL      &none   &kp F4  &kp F5  &kp F6  &kp F11  &none
&none  &bt_mac       &bt_win     &bt BT_SEL 2       &bt BT_SEL 3     &bt BT_SEL 4        &tog 1  &kp F1  &kp F2  &kp F3  &kp F12  &none
                                 &none              &none            &none               &none   &none   &none
            >;

            label = "bluetoo";
        };
    };
};
