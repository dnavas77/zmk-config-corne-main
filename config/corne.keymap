// Mouse settings

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1500  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20    // default: 10

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

&lt { tapping-term-ms = <170>; };

&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <170>;
};

/ {
    combos {
        compatible = "zmk,combos";

        right_control_win {
            bindings = <&kp RIGHT_CONTROL>;
            key-positions = <40 19>;
            layers = <0>;
        };

        right_opt_mac {
            bindings = <&kp RIGHT_ALT>;
            key-positions = <40 19>;
            layers = <2>;
        };
    };

    macros {
        bt_mac: bt_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0 &to 2>;
            label = "BT_MAC";
        };

        bt_win: bt_win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1 &to 0>;
            label = "BT_WIN";
        };

        tap_f1: tap_f1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp F1>;

            label = "tap_f1";
        };

        tap_f2: tap_f2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp F2>;

            label = "tap_f2";
        };

        tap_f3: tap_f3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp F3>;

            label = "tap_f3";
        };

        tap_f4: tap_f4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp F4>;

            label = "tap_f4";
        };

        tap_f5: tap_f5 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp F5>;

            label = "tap_f5";
        };

        tap_f6: tap_f6 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp F6>;

            label = "tap_f6";
        };

        tap_f7: tap_f7 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp F7>;

            label = "tap_f7";
        };

        tap_f8: tap_f8 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp F8>;

            label = "tap_f8";
        };

        tap_f9: tap_f9 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp F9>;

            label = "tap_f9";
        };

        tap_f10: tap_f10 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp F10>;

            label = "tap_f10";
        };

        tap_f11: tap_f11 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp F11>;

            label = "tap_f11";
        };

        tap_f12: tap_f12 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp F12>;

            label = "tap_f12";
        };
    };

    behaviors {
        hold_tap_f1: hold_tap_f1 {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_TAP_F1";
            bindings = <&tap_f1>, <&kp>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <250>;
        };

        hold_tap_f2: hold_tap_f2 {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_TAP_F2";
            bindings = <&tap_f2>, <&kp>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <250>;
        };

        hold_tap_f3: hold_tap_f3 {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_TAP_F3";
            bindings = <&tap_f3>, <&kp>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <250>;
        };

        hold_tap_f4: hold_tap_f4 {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_TAP_F4";
            bindings = <&tap_f4>, <&kp>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <250>;
        };

        hold_tap_f5: hold_tap_f5 {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_TAP_F5";
            bindings = <&tap_f5>, <&kp>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <250>;
        };

        hold_tap_f6: hold_tap_f6 {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_TAP_F6";
            bindings = <&tap_f6>, <&kp>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <250>;
        };

        hold_tap_f7: hold_tap_f7 {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_TAP_F7";
            bindings = <&tap_f7>, <&kp>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <250>;
        };

        hold_tap_f8: hold_tap_f8 {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_TAP_F8";
            bindings = <&tap_f8>, <&kp>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <250>;
        };

        hold_tap_f9: hold_tap_f9 {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_TAP_F9";
            bindings = <&tap_f9>, <&kp>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <250>;
        };

        hold_tap_f10: hold_tap_f10 {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_TAP_F10";
            bindings = <&tap_f10>, <&kp>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <250>;
        };

        hold_tap_f11: hold_tap_f11 {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_TAP_F11";
            bindings = <&tap_f11>, <&kp>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <250>;
        };

        hold_tap_f12: hold_tap_f12 {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_TAP_F12";
            bindings = <&tap_f12>, <&kp>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <250>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        win_main {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&none  &kp Q             &kp W  &kp E         &kp R  &kp T               &kp Y      &kp U        &kp I       &kp O    &kp P                         &none
&none  &mt LEFT_ALT A    &kp S  &kp D         &kp F  &kp G               &kp H      &kp J        &kp K       &kp L    &mt RIGHT_CONTROL APOSTROPHE  &none
&none  &mt LEFT_SHIFT Z  &kp X  &kp C         &kp V  &kp B               &kp N      &kp M        &kp COMMA   &kp DOT  &mt RIGHT_SHIFT SLASH         &none
                                &kp LEFT_GUI  &mo 3  &kp LEFT_CONTROL    &kp ENTER  &lt 4 SPACE  &kp ESCAPE
            >;

            label = "windows";
        };

        colemak-dh {
            bindings = <
&none  &kp Q  &kp W  &kp F   &kp P   &kp B     &kp J   &kp L   &kp U      &kp Y    &kp APOSTROPHE  &none
&none  &kp A  &kp R  &kp S   &kp T   &kp G     &kp M   &kp N   &kp E      &kp I    &kp O           &none
&none  &kp Z  &kp X  &kp C   &kp D   &kp V     &kp K   &kp H   &kp COMMA  &kp DOT  &kp SLASH       &none
                     &trans  &trans  &trans    &trans  &trans  &trans
            >;

            label = "colemak";
        };

        mac_main {
            bindings = <
&none  &trans  &trans  &trans            &trans  &trans          &trans  &trans       &trans  &trans  &trans                    &none
&none  &trans  &trans  &trans            &trans  &trans          &trans  &trans       &trans  &trans  &mt RIGHT_ALT APOSTROPHE  &none
&none  &trans  &trans  &trans            &trans  &trans          &trans  &trans       &trans  &trans  &trans                    &none
                       &kp LEFT_CONTROL  &trans  &kp LEFT_GUI    &trans  &lt 5 SPACE  &trans
            >;

            label = "macbook";
        };

        numbers_symbols {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BSPC |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&none  &kp TAB         &kp LEFT_PARENTHESIS  &kp DOUBLE_QUOTES  &kp RIGHT_PARENTHESIS  &kp LESS_THAN    &kp GREATER_THAN  &hold_tap_f7 F7 N7        &hold_tap_f8 F8 N8        &hold_tap_f9 F9 N9        &hold_tap_f11 F11 PLUS  &none
&none  &kp BACKSPACE   &kp LEFT_BRACKET      &kp MINUS          &kp RIGHT_BRACKET      &kp SEMICOLON    &kp PIPE          &hold_tap_f4 F4 NUMBER_4  &hold_tap_f5 F5 N5        &hold_tap_f6 F6 NUMBER_6  &hold_tap_f12 0 EQUAL   &none
&none  &kp LEFT_SHIFT  &kp LEFT_BRACE        &kp UNDERSCORE     &kp RIGHT_BRACE        &kp GRAVE        &kp BACKSLASH     &hold_tap_f1 0 NUMBER_1   &hold_tap_f2 F2 NUMBER_2  &hold_tap_f3 F3 NUMBER_3  &kp SLASH               &none
                                             &trans             &trans                 &trans           &trans            &hold_tap_f10 0 N0        &trans
            >;

            label = "symbols";
        };

        win_nav {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BSPC |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&none  &none           &none  &none  &none  &none               &kp HOME        &kp PAGE_DOWN   &kp PAGE_UP   &kp END          &kp PRINTSCREEN  &none
&none  &none           &none  &none  &none  &none               &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &kp DELETE       &none
&none  &kp LEFT_SHIFT  &none  &none  &none  &none               &none           &kp TAB         &none         &none            &kp RIGHT_ALT    &none
                              &none  &mo 6  &kp LEFT_CONTROL    &none           &none           &none
            >;

            label = "win_nav";
        };

        mac_nav {
            bindings = <
&none  &none           &none  &none  &none  &none           &kp LG(LEFT_ARROW)  &kp PAGE_DOWN   &kp PAGE_UP   &kp LG(RIGHT_ARROW)  &kp LS(LG(NUMBER_4))  &none
&none  &none           &none  &none  &none  &none           &kp LEFT_ARROW      &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW      &kp DELETE            &none
&none  &kp LEFT_SHIFT  &none  &none  &none  &none           &none               &kp TAB         &none         &none                &kp RIGHT_GUI         &none
                              &none  &mo 6  &kp LEFT_ALT    &none               &none           &none
            >;

            label = "mac_nav";
        };

        bt_mouse {
            bindings = <
&none  &out OUT_TOG  &kp C_MUTE  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp C_PLAY_PAUSE    &tog 2  &none  &none  &none  &none  &none
&none  &none         &none       &none              &bt BT_CLR       &bt BT_CLR_ALL      &none   &none  &none  &none  &none  &none
&none  &bt_mac       &bt_win     &bt BT_SEL 2       &bt BT_SEL 3     &bt BT_SEL 4        &tog 1  &none  &none  &none  &none  &none
                                 &none              &none            &none               &none   &none  &none
            >;

            label = "bt_mous";
        };
    };
};
